{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StockNewsResponse",
  "type": "object",
  "required": [
    "symbol",
    "articles",
    "summary"
  ],
  "properties": {
    "symbol": {
      "type": "string",
      "description": "The requested Yahoo Finance symbol."
    },
    "articles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NewsArticle"
      }
    },
    "summary": {
      "type": [
        "string",
        "null"
      ],
      "description": "AI overview of the returned articles, as plain text. Null when unavailable."
    }
  },
  "$defs": {
    "NewsArticle": {
      "type": "object",
      "required": [
        "id",
        "title",
        "summary",
        "pubDate",
        "provider",
        "canonicalUrl",
        "analysis",
        "thumbnail"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ],
          "description": "Original publisher or Yahoo Finance article summary."
        },
        "pubDate": {
          "type": "string",
          "format": "date-time"
        },
        "provider": {
          "type": "object",
          "required": [
            "displayName"
          ],
          "properties": {
            "displayName": {
              "type": "string"
            }
          }
        },
        "canonicalUrl": {
          "type": "object",
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "analysis": {
          "type": [
            "string",
            "null"
          ],
          "description": "AI interpretation of this article, as plain text. Null when unavailable."
        },
        "thumbnail": {
          "description": "Existing NewsContent thumbnail. Null when no image is available.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "originalUrl"
              ],
              "properties": {
                "originalUrl": {
                  "type": "string",
                  "format": "uri"
                },
                "originalWidth": {
                  "type": "integer"
                },
                "originalHeight": {
                  "type": "integer"
                },
                "resolutions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "url",
                      "width",
                      "height",
                      "tag"
                    ],
                    "properties": {
                      "url": {
                        "type": "string",
                        "format": "uri"
                      },
                      "width": {
                        "type": "integer"
                      },
                      "height": {
                        "type": "integer"
                      },
                      "tag": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
